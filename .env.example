# ────────────────────────────────────────────────────────────
# SehatSakhi AI — Root Environment Configuration
# Copy this to .env and fill in your values
# ────────────────────────────────────────────────────────────

# ── LLM Provider: openai | groq | ollama ─────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...your-key...
OPENAI_MODEL=gpt-4o-mini

# Groq (alternative)
GROQ_API_KEY=gsk_...your-key...
GROQ_MODEL=llama3-70b-8192

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── STT: whisper_api | faster_whisper ────────────────────────
STT_PROVIDER=whisper_api

# ── TTS: elevenlabs | edge_tts ───────────────────────────────
TTS_PROVIDER=edge_tts
ELEVENLABS_API_KEY=

# ── Vision: openai_vision | medgemma ─────────────────────────
VISION_PROVIDER=openai_vision

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./sehatsakhi.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sehatsakhi

# ── RAG / ChromaDB ───────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── Server ───────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Uploads ──────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10
