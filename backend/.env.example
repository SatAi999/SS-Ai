# ── LLM Provider ─────────────────────────────────────────────
# Options: openai | groq | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
GROQ_API_KEY=gsk_your-groq-key-here

# ── Models ────────────────────────────────────────────────────
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
GROQ_CHAT_MODEL=llama3-70b-8192
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3

# ── Voice ─────────────────────────────────────────────────────
# Options: whisper_api | faster_whisper
STT_PROVIDER=whisper_api
# Options: elevenlabs | edge_tts
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your-elevenlabs-key-here
ELEVENLABS_VOICE_ID_EN=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID_HI=your-hindi-voice-id

# ── Vision ────────────────────────────────────────────────────
# Options: medgemma | openai_vision
VISION_PROVIDER=openai_vision
# MedGemma model (requires Hugging Face access)
MEDGEMMA_MODEL_ID=google/medgemma-4b-it
HUGGING_FACE_TOKEN=hf_your-token-here

# ── Database ──────────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./sehatsakhi.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sehatsakhi

# ── RAG / ChromaDB ────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── App ───────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Uploads ───────────────────────────────────────────────────
UPLOAD_DIR=./uploads/images
MAX_IMAGE_SIZE_MB=10
